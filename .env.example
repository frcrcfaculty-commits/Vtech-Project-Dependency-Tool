# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email: compose_link (default, works today) | gmail_api (needs Workspace domain-wide delegation) | dryrun
EMAIL_MODE=compose_link
# gmail_api only: full JSON key of a Google Cloud service account, single line
GOOGLE_SERVICE_ACCOUNT_JSON=
# gmail_api only: real @vtechpl.com mailbox the weekly digest is sent from
DIGEST_SENDER_EMAIL=

# WhatsApp: link (default, free, PM taps send) | meta (Cloud API, paid per message, needs approved template)
WHATSAPP_MODE=link
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=site_dependency_reminder
META_WA_TEMPLATE_LANG=en
META_WA_API_VERSION=v23.0

# Vercel Cron auth (any long random string)
CRON_SECRET=

# scripts/bootstrap.ts only
BOOTSTRAP_USERS=[{"email":"vipul@vtechpl.com","fullName":"Vipul Shah","role":"super_admin"},{"email":"hansalgandhi@gmail.com","fullName":"Hansal Gandhi","role":"super_admin"},{"email":"pmlead@vtechpl.com","fullName":"PM Lead","role":"pm_lead"}]
