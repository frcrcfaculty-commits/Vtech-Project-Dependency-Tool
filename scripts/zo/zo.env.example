# Copy to ~/vtech/zo.env on the Zo machine (never commit the filled copy). Read by scripts/zo/run.sh.
# NEXT_PUBLIC_* values are baked in at build time, so a change needs a rebuild (run.sh rebuilds when this file changes).

NEXT_PUBLIC_SUPABASE_URL=https://jqjoxlunlbmwyxowvkyf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the Zo service, no trailing slash. Used for the logo in reminder emails.
NEXT_PUBLIC_LOGO_URL=https://<your-zo-url>/vtech-logo-email.png

EMAIL_MODE=compose_link
WHATSAPP_MODE=link
# Must equal app_secrets('cron_secret') in Supabase:  select value from app_secrets where key = 'cron_secret';
CRON_SECRET=

# Optional: Supabase Postgres connection string (Project settings → Database → Connection string → Session pooler).
# When set, run.sh takes a daily pg_dump into ~/vtech/backups (keeps 14). Supabase's free plan has no backups.
SUPABASE_DB_URL=

# Optional (only if you switch these modes on later)
GOOGLE_SERVICE_ACCOUNT_JSON=
DIGEST_SENDER_EMAIL=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Supervisor settings (defaults shown)
# PORT=3000
# BRANCH=main
# POLL_SECONDS=300
